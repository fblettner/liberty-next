# Keep the build context small + the image clean. The frontend is built inside the image
# (Stage 1), so we ship sources but never the local node_modules / dist / venv.
.git
.gitignore
.venv
venv
**/__pycache__
*.py[cod]
*.egg-info
.pytest_cache
.mypy_cache
.ruff_cache
htmlcov
test-report.html
build
dist
.DS_Store

# Frontend: let `npm ci` + `npm run build` regenerate these in-image.
frontend/node_modules
frontend/dist

# Local secrets / per-deployment state — never bake into an image.
.env
config/auth.toml
config/auth.toml.tmp
config/local.toml
*.db
liberty.db

# Docs / tooling that don't belong in the runtime image.
docs
tests
**/*.md
docker-compose*.yml
Dockerfile
.dockerignore
