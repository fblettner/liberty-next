# Keep the build context small + the image clean. The frontend is built inside the image
# (Stage 1), so we ship sources but never the local node_modules / dist / venv.
.git
.gitignore
.venv
venv
**/__pycache__
*.py[cod]
*.egg-info
.pytest_cache
.mypy_cache
.ruff_cache
htmlcov
test-report.html
build
dist
.DS_Store

# Frontend: let `npm ci` + `npm run build` regenerate these in-image.
frontend/node_modules
frontend/dist

# Local secrets / per-deployment state — never bake into an image.
.env
config/auth.toml
config/auth.toml.tmp
config/local.toml
*.db
liberty.db

# Docs / tooling that don't belong in the runtime image.
docs
tests
**/*.md
# …but the framework's release notes ARE runtime data — served at /admin/release-notes via
# importlib.resources.files("liberty"), so they must land in the pip-installed package. Re-include
# them (declared as package-data in pyproject) or Settings → Release notes shows "No release notes
# bundled with this build" in the container (works from source on a dev box either way).
!liberty/RELEASE.md
!liberty/RELEASE.fr.md
docker-compose*.yml
Dockerfile
.dockerignore
