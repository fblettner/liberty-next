#!/usr/bin/env bash
#
# Liberty Next — the one operator command for a Docker install (Compose layouts).
#
#   liberty install [light|full] [--tag X] [--ssl letsencrypt|provided …] [--apps <wheel>]
#   liberty start | stop | restart            # the stack, with the compose chain recorded in .env
#   liberty status                            # versions, chain in force, readiness, apps, last upgrade
#   liberty doctor                            # what's wrong and how to fix it
#   liberty ssl letsencrypt --domain D --email E      # enable / switch TLS AFTER the install
#   liberty ssl provided --domain D --cert-dir DIR --cert-file F --key-file K
#   liberty ssl off                           # back to plain HTTP
#   liberty apps <wheel> [--force-config]     # link or refresh the licensed apps
#   liberty upgrade [--tag X] [--apps <wheel>]   # doctor → backup → pull → restart → migrations → status
#   liberty backup [--keep DAYS] | liberty restore <backup-dir>
#   liberty logs [-f]                         # the liberty-next service's logs
#   liberty migrate [--dry-run]               # pending app schema migrations (liberty-admin migrate)
#
# Design rule (the lesson behind this script): the compose chain — layout, TLS overlay, apps
# overlay — is STATE, recorded in .env as COMPOSE_FILE. Only `ssl` and `apps` change it; every
# other command reuses it verbatim. Recomputing it from an unrelated run's flags is what used
# to drop the TLS + apps overlays on an upgrade ("all my config is gone").
#
# This script delegates to the historic scripts next to it (install.sh / install-apps.sh /
# backup.sh / upgrade.sh), which keep working on their own.
set -euo pipefail

here="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || realpath "$0" 2>/dev/null || echo "$0")")" && pwd)"
cd "$here"
ENV_FILE=".env"
SERVICE="liberty-next"

if [ -t 1 ]; then
  RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[0;33m'; BLUE='\033[0;34m'; BOLD='\033[1m'; NC='\033[0m'
else
  RED=''; GREEN=''; YELLOW=''; BLUE=''; BOLD=''; NC=''
fi
info()  { printf "${BLUE}▸${NC} %s\n" "$*"; }
ok()    { printf "${GREEN}✔${NC} %s\n" "$*"; }
warn()  { printf "${YELLOW}!${NC} %s\n" "$*"; }
die()   { printf "${RED}✗${NC} %s\n" "$*" >&2; exit 1; }

usage() { sed -n '3,20p' "$0" | sed 's/^# \{0,1\}//'; }

# ── .env helpers ───────────────────────────────────────────────────────────────
need_env() { [ -f "$ENV_FILE" ] || die ".env not found in $here — run './liberty install' first."; }
# Never fails (a missing key is just empty) — with `set -o pipefail` a bare grep miss would abort the caller.
env_get()  { { grep -E "^${1}=" "$ENV_FILE" 2>/dev/null || true; } | head -1 | cut -d= -f2-; }
env_set() {
  local key="$1" val="$2"
  if grep -qE "^${key}=" "$ENV_FILE"; then
    sed -i.bak "s|^${key}=.*|${key}=${val}|" "$ENV_FILE" && rm -f "${ENV_FILE}.bak"
  else
    printf '\n%s=%s\n' "$key" "$val" >> "$ENV_FILE"
  fi
}

# The chain recorded in .env, exported so `docker compose` ignores any stray compose.yaml
# found while walking up from the cwd (compose v2 checks the cwd BEFORE .env).
chain()   { env_get COMPOSE_FILE; }
compose() { COMPOSE_FILE="$(chain)" docker compose "$@"; }
layout_of_chain() { case "$(chain)" in docker-compose.light.yml*) echo light ;; docker-compose.full.yml*) echo full ;; docker-compose.swarm.yml*) echo swarm ;; *) echo unknown ;; esac; }
tls_of_chain()    { case "$(chain)" in *tls-letsencrypt*) echo letsencrypt ;; *tls-provided*) echo provided ;; *) echo off ;; esac; }
apps_in_chain()   { case ":$(chain):" in *:docker-compose.apps.yml:*) echo yes ;; *) echo no ;; esac; }

require_docker() {
  command -v docker >/dev/null 2>&1 || die "docker is not installed."
  docker compose version >/dev/null 2>&1 || die "docker compose v2 is not available."
}

wait_healthy() {
  local tries="${1:-60}"
  info "Waiting for $SERVICE to report healthy…"
  for _ in $(seq 1 "$tries"); do
    local st
    st=$(docker inspect --format='{{.State.Health.Status}}' "$SERVICE" 2>/dev/null || echo starting)
    case "$st" in
      healthy)   ok "$SERVICE is healthy."; return 0 ;;
      unhealthy) die "$SERVICE reported unhealthy — try: ./liberty logs" ;;
    esac
    sleep 2
  done
  warn "$SERVICE not healthy after $((tries * 2)) s — check ./liberty logs"
  return 1
}

in_container() { docker exec -i "$SERVICE" "$@"; }   # -i: the python heredocs below need stdin forwarded

# "up to date" | "N pending (app: n, …)" | "error: …" | "? …" — from `liberty-admin migrate
# --dry-run`'s JSON (exit 0 = up to date, 2 = pending, 1 = an app errored).
migrations_summary() {
  in_container sh -c 'liberty-admin migrate --dry-run 2>/dev/null' | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    print("? (could not query)"); sys.exit(0)
errs = [a for a in d["apps"] if a["status"] == "error"]
if errs:
    print("error: " + "; ".join(a["app"] + ": " + str(a.get("reason", "")) for a in errs)); sys.exit(0)
pend = [(a["app"], a.get("pending") or []) for a in d["apps"] if a.get("pending")]
if not pend:
    print("up to date" if d["apps"] else "no migratable app plugin"); sys.exit(0)
print(str(d["pending_total"]) + " pending (" + ", ".join(a + ": " + str(len(p)) for a, p in pend) + ")")
' 2>/dev/null || echo "? (could not query)"
}

# ── commands ───────────────────────────────────────────────────────────────────
cmd_install() {
  require_docker
  exec ./install.sh "$@"
}

cmd_start()   { need_env; require_docker; info "Starting (chain: $(chain))"; compose up -d; wait_healthy || true; }
cmd_stop()    { need_env; require_docker; info "Stopping"; compose stop; ok "stopped (volumes + .env kept)"; }
cmd_restart() { need_env; require_docker; info "Restarting $SERVICE"; compose restart "$SERVICE"; wait_healthy || true; }
cmd_logs()    { need_env; require_docker; compose logs --tail=200 "$@" "$SERVICE"; }

cmd_status() {
  need_env; require_docker
  local lay tls apps tag running
  lay="$(layout_of_chain)"; tls="$(tls_of_chain)"; apps="$(apps_in_chain)"; tag="$(env_get LIBERTY_IMAGE_TAG)"
  printf "${BOLD}Liberty Next — %s${NC}\n" "$here"
  printf "  layout        %s\n" "$lay"
  printf "  tls           %s%s\n" "$tls" "$([ "$tls" != off ] && printf ' (%s)' "$(env_get LIBERTY_DOMAIN)")"
  printf "  apps overlay  %s%s\n" "$apps" "$([ "$apps" = yes ] && printf ' (%s)' "$(env_get APPS_HOST_PATH)")"
  printf "  image tag     %s\n" "${tag:-latest}"
  printf "  chain         %s\n" "$(chain)"
  running=$(docker inspect --format='{{.State.Status}}/{{.State.Health.Status}}' "$SERVICE" 2>/dev/null || echo "not running")
  printf "  container     %s\n" "$running"
  if [ "$running" != "not running" ]; then
    printf "  framework     %s\n" "$(in_container python -c 'import liberty;print(liberty.__version__)' 2>/dev/null || echo '?')"
    printf "  apps bundle   %s\n" "$(in_container python -c "from importlib.metadata import version;print(version('liberty-apps'))" 2>/dev/null || echo 'not installed')"
    printf "  /ready        %s\n" "$(in_container curl -fsS "http://127.0.0.1:8000/ready" 2>/dev/null || echo 'NOT READY')"
    printf "  migrations    %s\n" "$(migrations_summary)"
    printf "  last upgrade  "; in_container python - <<'PY' 2>/dev/null || echo "?"
try:
    from liberty.config import load_settings
    from liberty.versioning import ConfigVersionStore
    rows = ConfigVersionStore(load_settings().connectors.config_path.parent).list_upgrades()  # newest first
    r = rows[0] if rows else None
    print(f"{r['component']} {r['from_version'] or '-'} → {r['to_version']} ({r['created_at'][:19]})" if r else "none recorded")
except Exception as e:
    print(f"? ({type(e).__name__})")
PY
  fi
}

cmd_doctor() {
  require_docker
  local problems=0
  # fail REPORTS and counts (bash locals are dynamically scoped, so it sees $problems); it must
  # return 0 — a non-zero status inside `if … else fail …; fi` would trip `set -e` and abort.
  fail() { printf "${RED}✗${NC} %s\n   → %s\n" "$1" "$2"; problems=$((problems + 1)); return 0; }
  pass() { printf "${GREEN}✔${NC} %s\n" "$1"; return 0; }

  if [ ! -f "$ENV_FILE" ]; then fail ".env is missing" "run ./liberty install [light|full]"; return 1; fi
  pass ".env present"
  local ch; ch="$(chain)"
  if [ -z "$ch" ]; then fail "COMPOSE_FILE not recorded in .env" "add COMPOSE_FILE=docker-compose.<layout>.yml (install.sh does this on re-run)"; else pass "compose chain: $ch"; fi
  local f
  for f in $(printf '%s' "$ch" | tr ':' ' '); do
    [ -f "$f" ] && pass "overlay file $f exists" || fail "overlay file $f missing" "you are not in the release/ directory of the right checkout"
  done
  local apps_path; apps_path="$(env_get APPS_HOST_PATH)"
  if [ -n "$apps_path" ]; then
    if [ "$(apps_in_chain)" = yes ]; then pass "apps overlay in the chain (APPS_HOST_PATH=$apps_path)"; else
      fail "APPS_HOST_PATH is set but docker-compose.apps.yml is NOT in COMPOSE_FILE — the container runs WITHOUT your apps config (it looks like an empty install)" "run: ./liberty apps <wheel>   (re-adds the overlay; idempotent)"; fi
    [ -d "$apps_path/config" ] && pass "apps config dir present" || fail "$apps_path/config not found" "re-run ./liberty apps <wheel>"
  else
    warn "no APPS_HOST_PATH — open-framework install (no licensed apps linked)"
  fi
  local key v
  for key in LIBERTY_JWT_SECRET LIBERTY_MASTER_KEY; do
    v="$(env_get "$key")"
    if [ -z "$v" ]; then fail "$key empty in .env" "generate: openssl rand -base64 48";
    elif [ "${#v}" -lt 32 ]; then fail "$key is ${#v} chars — below the 32 recommended" "rotate carefully: the master key encrypts every ENC: value; the JWT secret logs everyone out";
    else pass "$key set (${#v} chars)"; fi
  done
  case "$(tls_of_chain)" in
    provided)
      local cd; cd="$(env_get CERT_HOST_PATH)"
      [ -d "$cd" ] && pass "cert dir $cd present" || fail "CERT_HOST_PATH=$cd not found" "./liberty ssl provided --cert-dir …"
      [ -f traefik/dynamic/tls.yml ] && pass "traefik/dynamic/tls.yml present" || fail "traefik/dynamic/tls.yml missing" "./liberty ssl provided … regenerates it"
      ;;
    letsencrypt) [ -n "$(env_get LIBERTY_DOMAIN)" ] && pass "Let's Encrypt domain: $(env_get LIBERTY_DOMAIN)" || fail "LIBERTY_DOMAIN empty" "./liberty ssl letsencrypt --domain … --email …" ;;
  esac
  local vol
  for vol in liberty-config pg-data traefik-acme; do
    docker volume inspect "$vol" >/dev/null 2>&1 && pass "volume $vol exists" || warn "volume $vol absent (fine on light / before first start)"
  done
  local st; st=$(docker inspect --format='{{.State.Status}}' "$SERVICE" 2>/dev/null || echo "absent")
  if [ "$st" = running ]; then
    pass "$SERVICE running"
    if in_container curl -fsS "http://127.0.0.1:8000/ready" >/dev/null 2>&1; then pass "/ready: framework pool answers"; else fail "/ready → 503: the framework database is unreachable" "check the database / the default pool in connectors.toml"; fi
    local pend; pend="$(migrations_summary)"
    case "$pend" in
      *pending*) fail "schema migrations: $pend" "./liberty migrate" ;;
      error:*)   fail "schema migrations: $pend" "./liberty migrate --dry-run for the details" ;;
      \?*)       warn "schema migrations: $pend" ;;
      *)         pass "schema migrations: $pend" ;;
    esac
    local mk; mk="$(in_container python -c "
import tomllib
from liberty.config import load_settings
from liberty.crypto import decrypt_or_keep, is_encrypted
s = load_settings(); doc = tomllib.loads(s.connectors.config_path.read_text())
bad = [n for n, c in doc.get('pools', {}).items()
       if is_encrypted(c.get('password', '')) and decrypt_or_keep(c['password'], s.crypto.master_key)[1]]
print('ok' if not bad else 'cannot decrypt the password of pool(s): ' + ', '.join(bad))" 2>/dev/null || echo '?')"
    [ "$mk" = ok ] && pass "master key decrypts every pool password" || fail "master key check: $mk" "LIBERTY_MASTER_KEY in .env must be the key those ENC: values were made with"
  else
    warn "$SERVICE is $st — start it with ./liberty start"
  fi
  local free; free=$(df -Pk . | awk 'NR==2 {print int($4/1024)}')
  [ "$free" -gt 2048 ] && pass "disk free: ${free} MB" || fail "disk free: ${free} MB" "free space before pulling an image (~600 MB)"
  echo
  if [ "$problems" -eq 0 ]; then ok "no problems found"; return 0; fi
  printf "${RED}✗${NC} %s\n" "$problems problem(s) — see the → lines above" >&2
  return 1
}

cmd_ssl() {
  need_env; require_docker
  local mode="${1:-}"; shift || true
  local lay; lay="$(layout_of_chain)"
  [ "$lay" = full ] || die "TLS is wired on the full layout only (this install is '$lay')."
  case "$mode" in
    letsencrypt|provided)
      # install.sh --ssl on an existing .env swaps ONLY the TLS overlay in the recorded chain
      # (keeps the apps overlay), writes / removes tls.yml, and restarts the stack.
      info "Switching TLS to '$mode' (the apps overlay and every secret are kept)"
      ./install.sh full --ssl "$mode" "$@"
      ;;
    off)
      local ch; ch="$(chain | tr ':' '\n' | grep -vE '^docker-compose\.tls-(letsencrypt|provided)\.yml$' | paste -sd: -)"
      env_set COMPOSE_FILE "$ch"
      rm -f traefik/dynamic/tls.yml
      info "TLS overlay removed from the chain → $ch"
      compose up -d --remove-orphans; wait_healthy || true
      ;;
    *) die "usage: ./liberty ssl letsencrypt --domain D --email E | ssl provided --domain D --cert-dir DIR --cert-file F --key-file K | ssl off" ;;
  esac
}

cmd_apps() {
  need_env; require_docker
  [ -n "${1:-}" ] || die "usage: ./liberty apps <wheel-path-or-url> [--force-config]"
  ./install-apps.sh "$@" --layout "$(layout_of_chain)"
  cmd_migrate
}

cmd_migrate() {
  need_env; require_docker
  in_container liberty-admin migrate "$@"
}

cmd_backup()  { ./backup.sh "$@"; }

cmd_restore() {
  # Mirrors the restore recipe backup.sh prints: one <volume>.tar.gz per named volume (made with
  # `tar czf … -C /data .`), plus liberty-apps.tar.gz for the apps bind mount when it was set.
  need_env; require_docker
  local dir="${1:-}"; [ -d "$dir" ] || die "usage: ./liberty restore <backup-dir>   (a directory written by ./liberty backup)"
  local abs tgz vol
  abs="$(cd "$dir" && pwd)"
  info "Stopping the stack before restoring volumes"
  compose stop
  for tgz in "$abs"/*.tar.gz; do
    [ -f "$tgz" ] || continue
    vol="$(basename "$tgz" .tar.gz)"
    [ "$vol" = liberty-apps ] && continue   # the bind mount, handled below
    info "Restoring volume $vol from $(basename "$tgz")"
    docker volume create "$vol" >/dev/null
    docker run --rm -v "$vol":/data -v "$abs":/backup:ro alpine \
      sh -c "rm -rf /data/* /data/.[!.]* ; tar xzf /backup/$(basename "$tgz") -C /data"
  done
  local apps; apps="$(env_get APPS_HOST_PATH)"
  if [ -f "$abs/liberty-apps.tar.gz" ] && [ -n "$apps" ]; then
    info "Restoring the apps bundle into $apps"
    mkdir -p "$apps" && tar xzf "$abs/liberty-apps.tar.gz" -C "$apps"
  fi
  ok "restore done — starting"
  compose up -d; wait_healthy || true
}

cmd_upgrade() {
  # B1: doctor → backup → upgrade.sh (pull + recreate + health, with the recorded chain) →
  # migrations → status. The config merge + the upgrade report land in B2 / B4.
  need_env; require_docker
  local wheel="" tagargs=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --apps) [ -n "${2:-}" ] || die "--apps requires a wheel"; wheel="$2"; shift 2 ;;
      --tag)  [ -n "${2:-}" ] || die "--tag requires a value"; tagargs+=(--tag "$2"); shift 2 ;;
      *) die "unknown argument: $1" ;;
    esac
  done
  info "Pre-flight (advisory — an upgrade is often the fix for what doctor reports; the backup is the gate)"
  cmd_doctor || warn "doctor found problems — continuing; re-check with ./liberty doctor once the upgrade is done"
  info "Backup (gate: an upgrade never starts without one)"
  ./backup.sh --keep 30 || die "backup failed — upgrade aborted"   # --keep = days of backups retained
  ./upgrade.sh ${tagargs[@]+"${tagargs[@]}"}
  if [ -n "$wheel" ]; then cmd_apps "$wheel"; else cmd_migrate || warn "migrations reported a problem — see above"; fi
  cmd_status
}

cmd="${1:-help}"; shift || true
case "$cmd" in
  install)  cmd_install "$@" ;;
  start)    cmd_start ;;
  stop)     cmd_stop ;;
  restart)  cmd_restart ;;
  status)   cmd_status ;;
  doctor)   cmd_doctor ;;
  ssl)      cmd_ssl "$@" ;;
  apps)     cmd_apps "$@" ;;
  upgrade)  cmd_upgrade "$@" ;;
  backup)   cmd_backup "$@" ;;
  restore)  cmd_restore "$@" ;;
  logs)     cmd_logs "$@" ;;
  migrate)  cmd_migrate "$@" ;;
  help|-h|--help) usage ;;
  *) die "unknown command: $cmd (try ./liberty help)" ;;
esac
