# Liberty Next — deployment env vars.
#
# Copy to .env and edit. Both compose layouts (light + full) read this file.
# Values marked REQUIRED MUST be set; the compose file will refuse to start otherwise.

# ─── REQUIRED ─────────────────────────────────────────────────────────────────

# JWT signing key — used to sign every access + refresh token. MUST be stable across
# restarts (a rotated key forces every user to re-log in). Generate one with:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
LIBERTY_JWT_SECRET=

# Field-level encryption key — encrypts secrets (pool passwords / API tokens) at rest in
# the TOML files. MUST be the same value across restarts (or encrypted values become
# unreadable). Generate with:
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
LIBERTY_MASTER_KEY=

# ─── FULL LAYOUT ONLY ─────────────────────────────────────────────────────────

# Postgres root password — used by both the postgres container AND liberty-next's
# framework DB URL. The user defaults to "liberty" and the DB to "liberty"; override
# below if you want different ones.
POSTGRES_PASSWORD=
# POSTGRES_USER=liberty
# POSTGRES_DB=liberty
# POSTGRES_PORT=5432            # host-side port to expose pg on (DBeaver etc.); set "" to skip

# pgAdmin admin password (the email defaults to admin@example.com; override below).
PGADMIN_PASSWORD=
# PGADMIN_EMAIL=admin@example.com

# ── A note on ``$`` in passwords ──────────────────────────────────────────────
# Docker Compose performs ``${VAR}`` substitution on every value in this file too —
# a literal ``$`` in a password gets eaten (e.g. POSTGRES_PASSWORD=foo$bar becomes
# "foo" because Compose tries to expand ``$bar``). To be safe:
#   • Generate passwords without ``$``  (recommended — use letters + digits + - _),  OR
#   • Escape every ``$`` as ``$$`` here  (POSTGRES_PASSWORD=foo$$bar → "foo$bar").
# This caveat applies to POSTGRES_PASSWORD, PGADMIN_PASSWORD, LIBERTY_ADMIN_PASSWORD,
# and any other secret you put in this file.
#
# The Traefik dashboard password is NOT in this file — it lives in
# traefik/dynamic/dynamic.yml (bcrypt hash, no compose substitution). Edit there.

# ─── OPTIONAL ─────────────────────────────────────────────────────────────────

# Image tag — which ghcr.io/.../liberty-next:<tag> install.sh pulls.
#   <version>  — pinned (e.g. 7.0.1). Recommended for production. Changes only when
#                you bump this value + ``./install.sh full`` (or run docker compose pull).
#   latest     — most recent RELEASE (the release.yml workflow's last successful run).
#                Default. Updated only on a release, NOT on every push to main.
#   edge       — rolling tip of main. Updated on every push to main. Use this for
#                testing fixes between releases / running a demo server.
# LIBERTY_IMAGE_TAG=latest

# Bootstrap admin password — when set, the first-run admin user gets this password.
# Omit to have init-db generate a random one + print it once in the container logs.
# LIBERTY_ADMIN_PASSWORD=

# License key (RS256 JWT) — unlocks licensed connectors (nomasx1 / nomajde / nomaflow
# premium). Without a key the framework runs in "restricted" mode; everything else works.
# LIBERTY_LICENSE_KEY=

# Anthropic API key — enables the in-app AI assistant chat. Without it the assistant
# is disabled (the chat UI shows "AI is unavailable" and /ai/chat returns 404).
# ANTHROPIC_API_KEY=

# Framework DB URL — light layout defaults to SQLite on a volume; full layout points at
# the bundled Postgres. Override to point at an external DB.
# LIBERTY_DB_URL=postgresql+asyncpg://user:pw@host:5432/dbname

# OIDC (Single Sign-On) — set to true + fill the provider details to enable.
# LIBERTY_OIDC_ENABLED=false
# LIBERTY_OIDC_PROVIDER_URL=https://keycloak.example.com/realms/liberty
# LIBERTY_OIDC_CLIENT_ID=liberty-next
# LIBERTY_OIDC_CLIENT_SECRET=

# Light layout — host-side port to expose liberty-next on (default 8000).
# LIBERTY_PORT=8000

# Full layout — host-side port for Traefik's HTTP entrypoint (default 80).
# TRAEFIK_HTTP_PORT=80

# Full layout — only used when TLS is wired (uncomment the websecure section in
# docker-compose.full.yml + traefik/traefik.yml).
# LIBERTY_DOMAIN=liberty.example.com
# ACME_EMAIL=ops@example.com
