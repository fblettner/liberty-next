__pycache__/
*.py[cod]
*.egg-info/
.venv/
.env
.pytest_cache/
.mypy_cache/
.ruff_cache/
# pytest --html report (pytest-html, --self-contained-html); coverage HTML
test-report.html
htmlcov/
build/
dist/
.DS_Store
config/local.toml
# per-developer override of app.toml — set LIBERTY_APP_CONFIG=config/app-dev.toml in
# your shell/.env so encrypted license / api_key values land here (gitignored) instead
# of the committed config/app.toml
config/app-dev.toml
# the TOML auth store (Argon2 password hashes — a per-deployment secret); created by `liberty-admin init-db`
config/auth.toml
config/auth.toml.tmp
# per-deployment / licensed-app config — NOT committed; the open framework ships only the *.example
# templates (copy them, or run liberty-migrate). nomasx1 / nomajde etc. ship these files separately.
config/connectors.toml
config/connectors.toml.tmp
config/dictionary.toml
config/menus.toml
config/screens.toml
config/charts.toml
config/dashboards.toml
# local dev SQLite (the default [pools.default] when LIBERTY_DB_URL is unset)
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# local migration output (liberty-migrate -o …) — review/merge into config/, don't commit raw
/migrated*.toml

# Claude Code per-session runtime state — lock files, recall caches, etc.
# Claude Code: local settings stay out; the project's skills (.claude/skills/) are shared.
.claude/*
!.claude/skills/
config_backups/
# Server-managed config snapshot history (liberty.versioning) — lives next to the TOMLs
config/.versions/
# The kept documentation reports (liberty.docreport.archive) and the promotion history, same place
config/.reports/
config/.promotion/

# Working documents live in the private liberty-apps repo (docs/work/); a stray local copy here
# must never reach this public repo
docs/work/

# Oracle Instant Client zips are fetched at image build time (Dockerfile); a local copy here is
# only for air-gapped builds and must not be committed (146 MB).
docker/instantclient/*/*.zip
# the per-install notification rules (Settings → Notifications writes it); the example is the doc
config/notifications.toml
config/.logs/
config/.nomaflow/
