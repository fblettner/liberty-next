# Liberty Next — per-app screen definitions  (TEMPLATE — copy to `config/screens.toml`)
#
# The real `config/screens.toml` is *not* committed (per-deployment / licensed-app data). A missing
# file = no screens, which is fine — the framework still serves the raw connector/query flow. To populate:
#   • copy this file:  cp config/screens.toml.example config/screens.toml
#   • or migrate a v1 DB:  liberty-migrate screen --source-url postgresql+asyncpg://… --connector myapp -o config/screens.toml
#
# A screen collapses v1's table → dialog → tabs → fields → field-param-binds chain into one entity.
# Each [screens.<app>.<screen_id>] carries: the screen's read query + the CRUD companions (update/insert/
# delete_query), flags (auto_load / audit / editable / uploadable), an optional `columns` list (per-screen
# display metadata — the single source of truth), and an optional inline `dialog` with tabs and fields.
# `connector` is set only when the screen's queries live on a different connector than the app; otherwise
# it inherits the app name.
#
# Phase 2 layout — `Screen.columns` is the single source of truth for per-column display metadata (dd /
# label / format / rules / rules_values / default / lookup_param_binds / filter / width / align). The
# `[[screens.<app>.<sid>.dialog.tabs.fields]]` rows are **layout-only** — they reference a column by `name`
# and add placement (`colspan`) + dialog-context state (`hidden` / `disabled` / `required`) + conditional
# rules (`visible_when` / `required_when` / `disabled_when`). The same metadata drives the grid editor too.
#
# Permission gate: a screen is shown / openable iff the caller holds `sql:<connector>:<read_query>`.

# ── example ───────────────────────────────────────────────────────────────────────────
# [screens.myapp.security_users]
# label = "Users"
# description = "User accounts"
# read_query = "users_get"
# update_query = "users_put"
# insert_query = "users_post"
# delete_query = "users_delete"
# auto_load = true
# audit = true     # wire AUD_<table> writes
# # connector = "otherconn"   # only when the queries live on a different connector
#
# # Per-screen column metadata — single source of truth for grid + dialog.
# [[screens.myapp.security_users.columns]]
# name = "USR_ID"
# dd = "USR_ID"
# filter = true
# width = 120
#
# [[screens.myapp.security_users.columns]]
# name = "USR_ROLE_ID"
# dd = "ROL_ID"
# label = "Role"
# default = "ADMIN"
#
# # Bind the column's lookup query's `:ROL_APPS_ID` parameter to the form's USR_APPS_ID at call time.
# # Same `ParamBind` shape used by actions and row menus.
# [[screens.myapp.security_users.columns.lookup_param_binds]]
# param = "ROL_APPS_ID"
# source = "USR_APPS_ID"
#
# # ── dialog: layout-only fields reference the columns above by `name` ──────────────────
# [screens.myapp.security_users.dialog]
# title = "User"
#
# [[screens.myapp.security_users.dialog.tabs]]
# id = "general"
# label = "General"
# cols = 2
#
# [[screens.myapp.security_users.dialog.tabs.fields]]
# name = "USR_ID"
# required = true
#
# [[screens.myapp.security_users.dialog.tabs.fields]]
# name = "USR_ROLE_ID"
# colspan = 2
