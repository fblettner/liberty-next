# Data Explorer models — several per app ([explorer.<app>.<model>]: one data mart each; tables that do not
# relate to each other are different models). Permission: explorer:<app>:<model> (explorer:<app>:* for all). Copy to explorer.toml (or edit through Settings → Explorer).
# An entity is a parameterless SELECT of a connector; its fields are the query's result columns,
# labelled and typed through the dictionary and the screen's column hints. No SQL lives here.

[explorer.nomajde.sales]
label = "Sales"
hub = "sales"                         # the entity every analysis starts from

[explorer.nomajde.sales.entities.sales]
label = "Sales"
query = "fact_sales_get"              # of the app's connector (or set `connector = "..."`)
screen = "fact_sales"                 # optional: this screen's column hints (labels, formats, hidden)
key = ["ID"]
default_date = "SOLD_ON"              # the date a period applies to by default
measures = { QTY = "sum", REVENUE = "sum" }   # sum | avg | min | max | count | count_distinct
hidden = ["ID", "BATCH_ID"]

[explorer.nomajde.sales.entities.period]
label = "Period"
query = "period_status_get"
key = ["PERIOD"]
cardinality = "one"                   # rows of this entity per hub row: one (a dimension) | many (lines)

# A model may derive its entities and relations from a Screen Assistant preset (config/presets/**.toml,
# shipped with the app): the preset's tables become entities (SELECT * on each, the base table the hub),
# its joins on data items become relations resolved on the discovered columns (JDE prefixes handled).
# Declare an entity with the same `table` to add what the preset does not know: key, measures, date.
# [explorer.nomajde.address_book]
# label = "Address Book"
# preset = "address_book_master"
# [explorer.nomajde.address_book.entities.f0101]
# table = "F0101"
# schema = "#SCHEMA.DTA#"
# key = ["ABAN8"]
# default_date = "ABUPMJ"

[[explorer.nomajde.sales.relations]]        # every entity must reach the hub through relations
from = "sales"
to = "period"
on = [["PERIOD", "PERIOD"]]           # pairs: a column of `from`, a column of `to`

# Bundled analyses / dashboards: installed once into the saved-views store (shared), refreshed on
# a `version` bump only while nobody edited the copy; a deleted copy stays deleted.
[explorer.nomajde.sales.analyses.qty_by_company]
label = "Quantity by company"
audience = "sales"
version = 1
[explorer.nomajde.sales.analyses.qty_by_company.definition]
entity = "sales"
view = "table"
rows = [{ field = "sales.COMPANY" }, { field = "sales.SOLD_ON", bucket = "month" }]
measures = [{ field = "sales.QTY", agg = "sum" }, { field = "sales.REVENUE", agg = "sum" }]
filterRows = []
sort = []
limit = 1000
calculated = []

[explorer.nomajde.sales.dashboards.sales_home]
label = "Sales — home"
version = 1
[explorer.nomajde.sales.dashboards.sales_home.definition]
tiles = [{ analysis = "qty_by_company", w = 4, h = "m" }]
